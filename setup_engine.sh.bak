#!/data/data/com.termux/files/usr/bin/bash
# setup_engine.sh - Recursion Engine Full Upgrade
# Handles: local upgrades, remote fetch, derivative evolution, auto Git push/pull, notifications

### CONFIG
RECURSION_DIR="$HOME/recursion"
UPG_DIR="$RECURSION_DIR/upgrades"
DYN_DIR="$RECURSION_DIR/dynamic_updates"
BK_DIR="$RECURSION_DIR/backups"
LOG_FILE="$RECURSION_DIR/recursion_log.txt"
EXEC_DB="$RECURSION_DIR/executed_db.txt"
CORE="$RECURSION_DIR/core.sh"
BOOT_SCRIPT="$HOME/.termux/boot/startup.sh"
GITHUB_REPO="git@github.com:daytonakirk15-create/recursion-upgrades.git"
FETCH_INTERVAL=3600  # seconds
BRANCH="main"

mkdir -p "$UPG_DIR" "$DYN_DIR" "$BK_DIR" "$(dirname "$BOOT_SCRIPT")"

log(){ echo "$(date '+%F %T') - $1" | tee -a "$LOG_FILE"; }

# Load executed DB
declare -A EXEC
[ -f "$EXEC_DB" ] && while IFS='=' read -r f m; do EXEC["$f"]="$m"; done < "$EXEC_DB"

save_exec_db(){ : > "$EXEC_DB"; for k in "${!EXEC[@]}"; do echo "$k=${EXEC[$k]}" >> "$EXEC_DB"; done }

get_version(){ grep -m1 '^VERSION=' "$1" 2>/dev/null | cut -d'=' -f2 || echo "" }

backup_module(){ [ -f "$1" ] && cp -a "$1" "$BK_DIR/$(basename "$1")_$(date +%s)" 2>/dev/null && log "Backed up $1"; }

rollback_module(){ local f="$1"; local last=$(ls -1t "$BK_DIR/${f}_"* 2>/dev/null | head -n1); [ -n "$last" ] && cp -a "$last" "$UPG_DIR/$f" && log "Rolled back $f"; }

execute_mod(){
  local f="$1"; [ -f "$f" ] || return
  local fn=$(basename "$f"); local ver=$(get_version "$f"); local now=$(date '+%F %T')
  [ -n "${EXEC[$fn]}" ] && [ "$ver" = "${EXEC[$fn]%%|*}" ] && { log "Skip $fn (v$ver)"; return; }
  backup_module "$f"; bash "$f"; rc=$?
  if [ $rc -eq 0 ]; then EXEC["$fn"]="${ver}|$now"; save_exec_db; log "Executed $fn"; [ $(command -v termux-notification >/dev/null 2>&1; echo $?) -eq 0 ] && termux-notification --title "Module executed" --content "$fn (v:$ver)"; else log "Error $fn rc=$rc. Rolling back."; rollback_module "$fn"; fi
}

# Fetch remote updates
fetch_updates(){
  log "Fetching updates from GitHub..."
  TMP=$(mktemp -d)
  git clone --depth 1 -b "$BRANCH" "$GITHUB_REPO" "$TMP" >/dev/null 2>&1 || { log "Git clone failed"; return; }
  cp -u "$TMP"/*.mod "$DYN_DIR/" 2>/dev/null || true
  cp -u "$TMP"/upgrades/*.mod "$DYN_DIR/" 2>/dev/null || true
  rm -rf "$TMP"; log "Updates fetched"
}

# Push local upgrades
push_upgrades(){
  cd "$RECURSION_DIR"
  git add upgrades/*.mod
  git commit -m "Auto-upload recursion modules: $(date '+%F %T')" 2>/dev/null
  git pull --rebase origin "$BRANCH" 2>/dev/null
  git push origin "$BRANCH" 2>/dev/null
  log "Auto-pushed upgrades to GitHub"
}

# Generate derivative modules automatically
generate_derivatives(){
  for f in "$UPG_DIR"/*.mod; do
    local name="derived_$(date +%s).mod"
    echo -e "#!/data/data/com.termux/files/usr/bin/bash\nVERSION=1.0\necho 'Derived module from $f'" > "$UPG_DIR/$name"
    chmod +x "$UPG_DIR/$name"
    log "Generated $name"
  done
}

# Run one cycle
run_cycle(){
  shopt -s nullglob
  for f in "$UPG_DIR"/*.mod; do execute_mod "$f"; done
  for f in "$DYN_DIR"/*.mod; do cp -u "$f" "$UPG_DIR/"; execute_mod "$UPG_DIR/$(basename $f)"; done
  generate_derivatives
  push_upgrades
  shopt -u nullglob
  log "Cycle complete"
}

# Command line flags
[ "$1" = "--run-cycle" ] && { run_cycle; exit 0; }
[ "$1" = "--fetch-and-run" ] && { fetch_updates; run_cycle; exit 0; }

# Initial install & start core loop
fetch_updates
run_cycle
pgrep -f "$CORE" >/dev/null 2>&1 || nohup bash "$CORE" >/dev/null 2>&1 &
log "Setup finished. Tail logs with: tail -f $LOG_FILE"

# Core loop
cat > "$CORE" <<'EOF'
#!/data/data/com.termux/files/usr/bin/bash
while true; do
  bash "$HOME/recursion/setup_engine.sh" --fetch-and-run
  sleep 3600
done
EOF
chmod +x "$CORE"

# Install Termux boot
cat > "$BOOT_SCRIPT" <<'EOF'
#!/data/data/com.termux/files/usr/bin/bash
bash "$HOME/recursion/core.sh" &
EOF
chmod +x "$BOOT_SCRIPT"
log "Boot script installed at $BOOT_SCRIPT"
